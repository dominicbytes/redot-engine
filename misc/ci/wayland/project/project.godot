; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Wayland Lifecycle Probe"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("26.3", "Redot")

[autoload]

LifecycleProbe="*res://probe.gd"

[display]

window/size/viewport_width=640.0
window/size/viewport_height=360.0
display_server/driver.linuxbsd="wayland"

[editor_plugins]

enabled=["res://addons/lifecycle/plugin.cfg"]

[rendering]

renderer/rendering_method="gl_compatibility"
